# Copy to `.env` if your backend is not on the default address.
#
# NOTE: anything prefixed with VITE_ is bundled into the JavaScript and is
# therefore PUBLIC. Never put the Groq API key here - it belongs only in
# backend/.env, and the browser never talks to Groq directly.

VITE_API_BASE_URL=http://localhost:8000

# In production this is the deployed backend's URL, set as an environment
# variable in the hosting dashboard rather than in a file:
#   VITE_API_BASE_URL=https://complaint-qms-api.onrender.com
#
# Vite inlines this at BUILD time, not at runtime, so changing it means
# triggering a fresh deploy - editing the variable alone does nothing to a
# bundle that has already been built.
