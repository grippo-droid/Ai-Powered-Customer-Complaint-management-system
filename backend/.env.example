# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# Groq API key - create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model used for every LLM call in the LangGraph pipeline.
#
# The assignment specified `gemma2-9b-it`, but Groq DECOMMISSIONED that model
# (the API now returns 400 model_decommissioned). The brief also names
# `llama-3.3-70b-versatile` as an acceptable alternative, so that is the
# default here. Check https://console.groq.com/docs/models for what is live.
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# JWT signing key.
#
# THE VALUE BELOW IS A PUBLIC PLACEHOLDER. It is committed to a public
# repository, so it is not a secret to anyone - treat it as if it were
# printed in the README, because it effectively is. Anyone holding this key
# can mint a token for any user with any role.
#
# Generate your own before running anything that matters:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Must be at least 32 characters; the app refuses to start otherwise.
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=8ImfYOHDdN_yClxvC1LBXiTmX7pGt4ItOpyMBuM9TeA0wzOBMzsw7fJkuBLrn3G7

# Signing algorithm and token lifetime. HS256 is symmetric - one shared secret,
# which suits a single backend that issues and verifies its own tokens.
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# MySQL connection string (SQLAlchemy + PyMySQL driver).
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#
# Hosted MySQL providers require TLS and will refuse a plain connection. Append
# the system CA bundle so PyMySQL can verify their certificate:
#   ...:4000/complaint_qms?ssl_ca=/etc/ssl/certs/ca-certificates.crt
# A password with @ : / or ? in it must be percent-encoded, or the URL parser
# will split the string in the wrong place.
DATABASE_URL=mysql+pymysql://qms_user:your_password_here@localhost:3306/complaint_qms

# Comma-separated origins allowed to call the API (the Vite dev server).
# In production this is the deployed frontend's origin, e.g.
#   CORS_ORIGINS=https://your-app.vercel.app
# No trailing slash, and never "*" - see the note in app/main.py.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI turns allowed per client IP per hour. 0 disables the limit, which is the
# right setting locally - it exists to stop one visitor to the public demo
# draining the shared Groq daily quota. The deployment sets 10.
RATE_LIMIT_PER_HOUR=0
